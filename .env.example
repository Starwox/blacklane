# ---------------------------------------------------------------
#  Variables PUBLIQUES (incluses dans le code envoyé au navigateur)
#  Supabase → Project Settings → API
# ---------------------------------------------------------------
# URL du projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Clé « anon » / publishable : publique par conception, protégée par les règles RLS
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# ---------------------------------------------------------------
#  Variables SECRÈTES — uniquement dans Netlify (Site configuration →
#  Environment variables), jamais préfixées par VITE_, jamais commitées.
#  Utilisées par la fonction serveur netlify/functions/admin-invite.mjs
# ---------------------------------------------------------------
# Même URL que ci-dessus
SUPABASE_URL=https://votre-projet.supabase.co
# Clé service_role : donne un accès total à la base. NE JAMAIS l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique du site (pour les liens d'invitation). Ex. https://blacklane.netlify.app
SITE_URL=https://votre-site.netlify.app
